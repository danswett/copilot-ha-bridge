{
  "homeAssistant": {
    "baseUrl": "http://homeassistant.local:8123",
    "token": "",
    "tokenEnvVar": "AGENT_HA_TOKEN"
  },
  "dashboard": {
    "urlPath": "agent-decisions"
  },
  "notifications": {
    "enabled": false,
    "service": "notify.notify",
    "tickerCategory": ""
  },
  "copilot": {
    "sessionStateRoot": ""
  },
  "newSession": {
    "enabled": true,
    "launcher": "auto",
    "profiles": ["work", "home", "local"],
    "defaultProfile": "work",
    "defaultWorkspace": "Bridge",
    "resumeCount": 12,
    "workspaces": [
      { "label": "Bridge", "path": "~/repos/agent-ha-bridge" },
      "~/repos"
    ],
    "model": "",
    "allowAllTools": false,
    "extraArgs": [],
    "copilotPath": "",
    "agencyPath": ""
  },
  "clients": ["copilot"],
  "updates": {
    "repository": "danswett/agent-ha-bridge",
    "installedVersion": "",
    "checkForUpdates": true,
    "checkHours": 6
  }
}
